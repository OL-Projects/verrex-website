generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ──────────────────────────────────────────────
model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           String          @default("client") // admin | client | contractor | partner
  company        String?
  phone          String?
  address        String?
  city           String?
  postalCode     String?
  notes          String?
  isDemo         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  passwordResets   PasswordReset[]
  projects         Project[]           @relation("ClientProjects")
  appointments     Appointment[]       @relation("ClientAppointments")
  invoices         Invoice[]           @relation("ClientInvoices")
  sentMessages     Message[]           @relation("SentMessages")
  leads            Lead[]              @relation("AssignedLeads")
  activities       ProjectActivity[]
  annotations      ClientAnnotation[]
  assignedTasks    ProjectTask[]
  uploadedFiles    ProjectAttachment[]
  teamMemberships  ProjectTeamMember[]
  conversations    ConversationParticipant[]
  sentDocuments    Document[]          @relation("SentDocuments")
  receivedDocuments Document[]         @relation("ReceivedDocuments")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Projects ───────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending") // pending | in_progress | completed | cancelled
  type        String?  // new_construction | renovation | replacement | commercial
  address     String?
  city        String?
  postalCode  String?
  startDate   DateTime?
  endDate     DateTime?
  totalValue  Float?
  notes       String?

  coverPhotoUrl String?
  progress      Int      @default(0) // 0-100
  priority      String   @default("on_track") // on_track | at_risk | behind | on_hold

  clientId    String
  client      User     @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)

  appointments   Appointment[]
  invoices       Invoice[]
  activities     ProjectActivity[]
  annotations    ClientAnnotation[]
  tasks          ProjectTask[]
  attachments    ProjectAttachment[]
  teamMembers    ProjectTeamMember[]
  conversations  Conversation[]
  documents      Document[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// ─── Project Activity (Timeline Entries) ────────────────
model ProjectActivity {
  id        String   @id @default(cuid())
  type      String   // note | photo | document | status_change | task_completed | task_created | issue | resolved | progress | milestone | financial | file_uploaded
  content   String?  // text content of the entry
  metadata  String?  // JSON for extra data (old/new status, severity, amount, etc.)

  // Optional file attachments inline with the activity
  attachmentUrls String?  // JSON array of Vercel Blob URLs
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  annotations ClientAnnotation[]

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([type])
  @@index([createdAt])
}

// ─── Project Tasks ──────────────────────────────────────
model ProjectTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // todo | in_progress | done
  priority    String   @default("medium") // low | medium | high | urgent
  category    String   @default("other") // measurement | delivery | installation | inspection | punch_list | admin | other
  dueDate     DateTime?
  completedAt DateTime?

  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ─── Project Attachments (Files in Vercel Blob) ────────
model ProjectAttachment {
  id          String   @id @default(cuid())
  fileName    String
  fileUrl     String
  fileSize    Int?     // bytes
  fileType    String?  // mime type
  category    String   @default("photo") // photo | document | blueprint | contract | permit | other
  caption     String?

  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([category])
}

// ─── Project Team Members ───────────────────────────────
model ProjectTeamMember {
  id     String @id @default(cuid())
  role   String @default("member") // project_manager | installer | inspector | estimator | member

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

// ─── Appointments ───────────────────────────────────────
model Appointment {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("consultation") // consultation | measurement | installation | follow_up
  status    String   @default("scheduled") // scheduled | confirmed | completed | cancelled
  date      DateTime
  time      String?
  duration  Int?     // minutes
  location  String?
  notes     String?

  clientId  String
  client    User     @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([date])
}

// ─── Invoices ───────────────────────────────────────────
model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  amount      Float
  tax         Float    @default(0)
  total       Float
  status      String   @default("draft") // draft | sent | paid | overdue | cancelled
  dueDate     DateTime?
  paidDate    DateTime?
  description String?
  items       String?  // JSON string of line items

  clientId    String
  client      User     @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: Cascade)

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// ─── Conversations & Messages ───────────────────────────
model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("direct") // direct | group
  name        String?  // null for DMs, custom name for groups

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([projectId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?    // null = never read; for unread badge tracking

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  content        String       @db.Text
  attachmentUrls String?      // JSON array of file URLs

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  replyToId      String?      // ID of message being replied to
  editedAt       DateTime?    // When message was last edited
  deletedAt      DateTime?    // Soft delete timestamp

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── Documents (Inbox: Contracts, Estimations, Invoices as PDFs) ──
model Document {
  id          String    @id @default(cuid())
  type        String    // invoice | contract | estimation
  title       String
  description String?   @db.Text
  fileUrl     String    // PDF URL (Vercel Blob / Supabase storage)
  status      String    @default("sent") // draft | sent | viewed | signed

  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  senderId    String
  sender      User      @relation("SentDocuments", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User      @relation("ReceivedDocuments", fields: [recipientId], references: [id], onDelete: Cascade)

  readAt      DateTime? // null = unread (inbox badge)
  recalledAt  DateTime? // soft-recall (unsend) timestamp; null = active

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([recipientId])
  @@index([senderId])
  @@index([projectId])
  @@index([type])
  @@index([status])
}

// ─── Leads (CRM — scales to 10,000+) ───────────────────
model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  source      String   @default("website") // website | referral | phone | walk_in | home_depot
  type        String   @default("contact") // contact | quote | appointment | quick_quote
  status      String   @default("new") // new | contacted | qualified | converted | lost
  priority    String   @default("medium") // low | medium | high | urgent
  stage       String   @default("lead_received") // pipeline stage
  subject     String?
  message     String?  @db.Text
  notes       String?  @db.Text
  projectType String?
  budget      String?
  address     String?
  city        String?
  postalCode  String?
  metadata    String?  @db.Text // JSON for extra form data

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  convertedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([stage])
  @@index([source])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([name])
  @@index([email])
}

// ─── Client Annotations (Dual-Timeline Feedback Rail) ───
model ClientAnnotation {
  id             String   @id @default(cuid())
  position       String   // "before" | "at" | "after" — relative to the activity card
  type           String   // "note" | "photo" | "attachment"
  content        String?  @db.Text
  attachmentUrls String?  // JSON array of Vercel Blob URLs

  activityId     String
  activity       ProjectActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([activityId])
  @@index([projectId])
  @@index([authorId])
}
